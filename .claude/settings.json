{
  "hooks": {
      "postEdit": {
        "command": "echo ${file} | grep -q '\\.py$' && uv run ruff check --fix ${file} && uv run ruff format ${file} || true",
        "description": "Auto-lint and format after every file edit"
      },
      "preCommit": {
        "command": "uv run pytest tests/ --tb=short -q",
        "description": "Run tests before every commit"
      }
  },
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(uv sync:*)",
      "Bash(uv run:*)",
      "Bash(uv pip install:*)",
      "Bash(ruff:*)",
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git push)",
      "Bash(git rm:*)",
      "Bash(mkdir:*)",
      "Bash(echo:*)",
      "Bash(tree:*)"
    ],
    "deny": [
      "Read(credentials/**)",
      "Read(.env)"
    ]
  }
}
